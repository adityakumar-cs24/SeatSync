{
  "name": "seatsync",
  "version": "1.0.0",
  "description": "High-concurrency event booking backend with atomic seat locking and idempotent payments",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node-pg-migrate",
    "worker": "node src/worker.js",
    "dev:worker": "nodemon src/worker.js",
    "make-admin": "node scripts/make-admin.js",
    "test": "jest --runInBand",
    "test:pool": "DB_POOL_MAX=2 jest --runInBand tests/integration/poolRegression.test.js"
  },
