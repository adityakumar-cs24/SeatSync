PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5433/dbname

# Redis
REDIS_URL=redis://localhost:6379

# Reconciler (optional, defaults shown)
RECONCILER_INTERVAL_MS=30000
STALE_PENDING_SECONDS=300

# Auth
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=15m
BCRYPT_COST=12
REFRESH_TTL_DAYS=7

# Optional: DB pool size (default 20)
DB_POOL_MAX=20
